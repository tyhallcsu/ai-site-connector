{
    "name": "tyhallcsu/ai-site-connector",
    "description": "Reusable WordPress plugin for securely connecting AI coding agents to self-hosted WordPress sites using REST API Application Passwords.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        { "name": "sharmanhall" }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "10up/wp_mock": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "AISiteConnector\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "lint": [
            "find . -name '*.php' -not -path './vendor/*' -not -path './.git/*' -not -path './build/*' -not -path './dist/*' -print0 | xargs -0 -n1 -P4 php -l"
        ],
        "phpcs": [
            "phpcs --standard=phpcs.xml.dist"
        ],
        "phpcbf": [
            "phpcbf --standard=phpcs.xml.dist"
        ],
        "security-grep": [
            "tests/security-grep.sh"
        ],
        "test": [
            "phpunit --configuration tests/phpunit/phpunit.xml"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
